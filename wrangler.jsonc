{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mara-sandra-connect",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Produção só no domínio próprio; workers.dev segue desligado.
  "workers_dev": false,
  // Cada versão de branch (build de PR) ganha URL de preview:
  // https://<8-chars-do-version-id>-mara-sandra-connect.nairaromerovian.workers.dev
  "preview_urls": true,
  // Espelha o que esta configurado no painel da Cloudflare, pra que o deploy
  // nao sobrescreva. Workers Logs LIGADOS desde 2026-08-21: sem eles o unico
  // caminho de diagnostico de SSR era o wrapper de erro em src/server.ts.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "routes": [
    { "pattern": "marasandraconnect.com", "custom_domain": true },
    { "pattern": "www.marasandraconnect.com", "custom_domain": true }
  ],
  // STAGING = worker SEPARADO (mara-sandra-connect-staging), com projeto
  // proprio no Workers Builds apontando pra branch "staging". O build desse
  // projeto roda com CLOUDFLARE_ENV=staging, e o Vite plugin gera o config
  // com o nome e as rotas abaixo — nunca as de producao.
  // NUNCA rodar `wrangler deploy` pra staging a partir do projeto de producao:
  // o token de build de la so enxerga o worker mara-sandra-connect (ver
  // incidente de 2026-08-22 em planning/DIAGNOSTICO_PREVIEW_URL.md).
  "env": {
    "staging": {
      "name": "mara-sandra-connect-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "logs": { "enabled": true, "invocation_logs": true } },
      "routes": [{ "pattern": "staging.marasandraconnect.com", "custom_domain": true }]
    }
  }
}
