{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mara-sandra-connect",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Produção só no domínio próprio; workers.dev segue desligado.
  "workers_dev": false,
  // Cada versão de branch (build de PR) ganha URL de preview:
  // https://<8-chars-do-version-id>-mara-sandra-connect.nairaromerovian.workers.dev
  "preview_urls": true,
  "routes": [
    { "pattern": "marasandraconnect.com", "custom_domain": true },
    { "pattern": "www.marasandraconnect.com", "custom_domain": true }
  ]
}
