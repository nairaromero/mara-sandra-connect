{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mara-sandra-connect",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Produção só no domínio próprio; workers.dev segue desligado.
  "workers_dev": false,
  // Cada versão de branch (build de PR) ganha URL de preview:
  // https://<8-chars-do-version-id>-mara-sandra-connect.nairaromerovian.workers.dev
  "preview_urls": true,
  // Espelha o que esta configurado no painel da Cloudflare, pra que o deploy
  // nao sobrescreva. Workers Logs LIGADOS desde 2026-08-21: sem eles o unico
  // caminho de diagnostico de SSR era o wrapper de erro em src/server.ts.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "routes": [
    { "pattern": "marasandraconnect.com", "custom_domain": true },
    { "pattern": "www.marasandraconnect.com", "custom_domain": true }
  ],
  // Ambiente de staging: deploy automatico quando a branch "staging" recebe push.
  // O script scripts/cf-version.sh detecta WORKERS_CI_BRANCH=staging e roda
  // `wrangler deploy --env staging` em vez de `wrangler versions upload`.
  // O build do Vite ja aponta pro banco de staging via WORKERS_CI_BRANCH.
  "env": {
    "staging": {
      "routes": [
        { "pattern": "staging.marasandraconnect.com", "custom_domain": true }
      ]
    }
  }
}
