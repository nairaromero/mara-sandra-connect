# Modelo das variaveis locais. Copie para .env.local e preencha.
#
#   cp .env.example .env.local
#
# .env.local e gitignored. NUNCA commite valores reais.
# Nem toda variavel e obrigatoria — veja o comentario de cada bloco.

# =========================================================================
# FRONTEND — decide QUAL BANCO o dev local e os E2E usam
# SEM elas o dev local cai em PRODUCAO (fallback em src/lib/supabase.ts).
# Apontam pro STAGING. A URL e a chave anon de staging nao sao segredo:
# estao em texto em vite.config.ts (a chave anon e publica por design).
# =========================================================================
VITE_SUPABASE_URL=https://alhqbpbekmxpoibrrnbi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google Drive (Picker): credenciais hardcoded em src/lib/google-drive.ts
# (nenhuma env var). So funciona em origem cadastrada no Google Cloud —
# producao, e staging.marasandraconnect.com se alguem cadastrar.

# =========================================================================
# ADMINISTRACAO — Supabase Management API
# Obrigatoria para scripts/msc-sql.mjs.
# Gerar em: https://supabase.com/dashboard/account/tokens
# SEM a flag --staging o script roda em PRODUCAO.
# =========================================================================
SUPABASE_ACCESS_TOKEN=

# =========================================================================
# PRODUCAO — credenciais que IGNORAM RLS. Nunca no browser, nunca no git.
# So preencha o que for mesmo usar.
# =========================================================================
SUPABASE_URL=https://llugytkdsfsrciavhrfw.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Role SO DE LEITURA de producao usado pelo espelho (scripts/espelho-staging.sh).
# Criado por migration_espelho_role_leitura.sql; a senha e definida a mao:
#   node scripts/msc-sql.mjs "alter role espelho_leitura password '<senha>'"
# O espelho NAO usa SUPABASE_DB_PASSWORD.
ESPELHO_LEITURA_PASSWORD=

# =========================================================================
# STAGING — espelho anonimizado (projeto alhqbpbekmxpoibrrnbi)
# STAGING_SERVICE_ROLE_KEY e STAGING_SYNTH_PASSWORD sao obrigatorias pros E2E.
# STAGING_SYNTH_PASSWORD e a senha unica de TODOS os usuarios sinteticos do
# espelho — inclusive as contas de papel e2e+admin / e2e+interno /
# e2e+parceiro@marasandraconnect.com (scripts/seed-staging-contas.mjs).
# STAGING_DB_PASSWORD so e usada por scripts/espelho-staging.sh.
# =========================================================================
STAGING_PROJECT_REF=alhqbpbekmxpoibrrnbi
STAGING_PUBLISHABLE_KEY=
STAGING_SERVICE_ROLE_KEY=
STAGING_DB_PASSWORD=
STAGING_SYNTH_PASSWORD=
# So necessaria se os E2E rodarem contra PRODUCAO (nao e o padrao).
E2E_INTERNO_PASSWORD=
# Cloudflare Access na frente do staging (opcional): service token. Com os
# dois definidos, o playwright.config manda os headers CF-Access-Client-*.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# =========================================================================
# FERRAMENTAS EXTERNAS — nenhum codigo do repo le estas.
# Consumidas por CLI/servico de fora. Opcionais.
# =========================================================================
# wrangler (Cloudflare). Token custom, permissoes READ:
#   Workers Scripts / Workers Builds Configuration / Account Settings
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
N8N_BASE_URL=
N8N_API_KEY=

# =========================================================================
# INTEGRACOES — opcionais
# EVOLUTION_API_KEY: gateway de WhatsApp. A saida esta PAUSADA desde
#   2026-08-21 (planning/sql-migrations/migration_pausa_whatsapp_saida.sql).
# TI_TOKEN: Tramitacao Inteligente — sync desligado desde 2026-08-11.
# =========================================================================
EVOLUTION_API_KEY=
WHATSAPP_INBOUND_TOKEN=
TI_TOKEN=
